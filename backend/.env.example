# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit the real .env file.

# MongoDB connection string (required)
# Local:  mongodb://127.0.0.1:27017/civilManagement
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/civilManagement
MONGODB_URI=mongodb://127.0.0.1:27017/civilManagement

# Port the API listens on (optional, defaults to 5000).
# Keep it at 5000 - the frontend has this port hard-coded.
PORT=5000

# Secret for signing JWTs. Not used by the code yet; set a long random string.
JWT_SECRET=replace-with-a-long-random-string
